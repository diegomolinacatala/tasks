{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tasks-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "tasks-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "push-worker",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "worker",
        "run",
        "dev",
        "--",
        "--port",
        "8787"
      ],
      "port": 8787
    },
    {
      "name": "panel-test",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "worker",
        "run",
        "dev",
        "--",
        "--port",
        "8788",
        "--var",
        "FEEDBACK_KEY:clave-del-buzon-de-pruebas-0123456789"
      ],
      "port": 8788
    },
    {
      "name": "sync-worker",
      "runtimeExecutable": "npm",
